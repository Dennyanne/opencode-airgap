# opencode-airgap — runtime environment for the air-gapped machine
#
# Copy this file to ".env" in the directory you run opencode from (your project
# root / current working directory), then fill in your vLLM endpoint values.
# opencode runs on Bun, which auto-loads ".env" from the working directory into
# the environment; the embedded opencode.json then expands these via {env:VAR}.
#
#   cp .env.example .env      # (PowerShell: Copy-Item .env.example .env)
#
# NOTE: ".env" must live in the CWD you launch from — not next to the .exe —
# because it is loaded relative to the working directory, not the binary.
# To apply regardless of CWD, set these as Windows user env vars with `setx`.

# Base URL of the vLLM OpenAI-compatible API endpoint. Must include the /v1 suffix.
VLLM_BASE_URL=http://192.168.1.100:8000/v1

# API key sent as "Authorization: Bearer". vLLM usually ignores it, but it must
# be non-empty — use any placeholder such as "not-used".
VLLM_API_KEY=not-used

# Model ID exactly as the vLLM server reports it. Do NOT add a "vllm/" prefix —
# the bundled config already wraps this as "vllm/{env:VLLM_MODEL}".
VLLM_MODEL=meta-llama/Llama-3.1-70B-Instruct
