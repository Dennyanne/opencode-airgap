node_modules/
dist/
staging/
*.exe
*.log
.cache/
.DS_Store

# Keep staging layout but not fetched binaries
!staging/.gitkeep

# Spike compiled payloads and build outputs
spikes/*/payload/
spikes/*/dist/

# OMC runtime state — not part of the project source
.omc/sessions/
.omc/state/
.omc/project-memory.json

# Local runtime secrets — never commit. The .env.example template is tracked.
.env
.env.local
!.env.example
