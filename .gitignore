node_modules/
dist/
staging/
*.exe
*.log
.cache/
.DS_Store

# Keep staging layout but not fetched binaries
!staging/.gitkeep

# Spike compiled payloads and build outputs
spikes/*/payload/
spikes/*/dist/

# OMC internal planning/spec docs and runtime state — not part of the public project
.omc/

# Local runtime secrets — never commit. The .env.example template is tracked.
.env
.env.local
!.env.example
